# shop_risk_control 环境变量模板
# 用法：复制为 .env 后填写真实值；.env 严禁入库（BR-00-04）。
# 优先级：进程环境变量 > .env > 代码默认值（BR-00-01）。

# ==================== 运行环境 ====================
# dev / prod（前端错误提示与日志详细度据此区分）
APP_ENV=dev
# 服务端口（对齐概要设计 §2.4 部署形态）
APP_PORT=8101
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================== 数据库（必需项，缺失则启动失败 COM-5002）====================
# 必需！MongoDB 连接串。带凭据时形如 mongodb://user:pass@host:27017
MONGO_URL=
# 必需！业务库名
MONGO_DB_NAME=
# 可选项：测试库名（默认取 {MONGO_DB_NAME}_test，测试绝不污染业务库）
TEST_MONGO_DB_NAME=

# ==================== 鉴权（模块 01；JWT_SECRET 为必需项）====================
# 必需！JWT 签名密钥，**至少 32 字节**（缺失或过短则启动失败 AUTH-5002）。
# 生成方式：python -c "import secrets;print(secrets.token_hex(48))"
JWT_SECRET=
# 令牌有效期（分钟），默认 480 = 8 小时（BR-01-07）
JWT_EXPIRE_MINUTES=480
# 登录失败锁定：连续失败次数与锁定时长（BR-01-05，PRD 未要求）
# 默认 10 次 / 60 秒。窗口与锁定时长取同一值，"连续失败"以该窗口计。
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_SECONDS=60

# ==================== 限流（悬空点「限流策略」，模块 00 §8）====================
# 单窗口内单用户允许的请求数；超限返回 COM-4290
RATE_LIMIT_MAX_REQUESTS=60
# 窗口长度（秒）
RATE_LIMIT_WINDOW_SEC=60

# ==================== 对象存储（当前不启用，模块 00 §8）====================
# 仅在模块 08 需要上传证据文件时填写；留空不影响启动
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
